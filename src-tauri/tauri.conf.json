{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LexiGlass",
  "version": "1.0.0",
  "identifier": "com.lexiglass.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LexiGlass",
        "width": 440,
        "height": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' https: asset: data:; connect-src 'self' https://integrate.api.nvidia.com https:;"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:lexiglass.db"]
    }
  }
}
